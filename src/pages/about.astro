---
import BaseLayout from "../layouts/BaseLayout.astro";
import siteConfig from "../data/site.config.json";
import { breadcrumbListJsonLd } from "../lib/schema";

const siteUrl = `https://${siteConfig.domain}`;
const title = `About ${siteConfig.siteName} - independent UK carp gear reviews`;
const description = `Who we are, how we test, and why we take no manufacturer sponsorship. Independent carp fishing gear reviews for UK anglers.`;

const jsonLd = breadcrumbListJsonLd([
  { label: "Home", url: `${siteUrl}/` },
  { label: "About", url: `${siteUrl}/about/` },
]);
---
<BaseLayout
  title={title}
  description={description}
  indexable={true}
  crumbs={[{ label: "About" }]}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <article class="guide-content">
      <div class="page-head">
        <div class="kicker">About</div>
        <h1>About {siteConfig.siteName}</h1>
        <p class="lede">Independent carp fishing gear reviews for UK anglers. No sponsorship, no free kit from manufacturers, no rankings shaped by commission rates.</p>
      </div>

      <h2>Why this site exists</h2>
      <p>
        Most UK carp fishing content online is either written by tackle-shop staff whose job is to move stock, or by sponsored anglers whose
        rod bag came free. Both produce useful content and both have a bias. {siteConfig.siteName} puts the facts that decide a purchase
        (sizes, weights, materials, what fits with what, and what it costs) in one place, so you can compare kit before you buy.
      </p>

      <h2>How we research and score</h2>
      <p>
        We do not run hands-on tests of the products on this site. Our reviews are built from manufacturers' specifications, UK retailers'
        listings and published owner reviews, and we say where sources disagree. Scores out of 5 are our editorial judgement from those sources:
        how well the specs match the use the product is sold for, and how it compares with the alternatives at its price.
      </p>
      <p>
        Prices are typical prices we found in UK tackle shops on the date shown. They change often, and the price on Amazon can be higher or
        lower: check it on the day before you buy.
      </p>

      <h2>How we make money</h2>
      <p>
        Every product page and every guide on this site carries Amazon UK affiliate links. When a reader buys through one of those links,
        Amazon pays us a small commission. This costs the reader nothing extra. It is our only source of income.
      </p>
      <p>
        Amazon's commission does not depend on the brand you buy, so we have no reason to push one manufacturer over another. Specialist UK
        tackle shops are often cheaper than Amazon for big items such as bivvies and alarms, and our prices come from them.
      </p>
      <p>
        Full details of our commercial relationships are on the <a href="/affiliate-disclosure/">affiliate disclosure page</a>.
      </p>

      <h2>Who writes this</h2>
      <p>
        {siteConfig.siteName} is a small independent editorial site. Editorial decisions are made on the kit's specs and sources, not on which
        brand happens to be promoting.
      </p>

      <h2>Corrections and disagreements</h2>
      <p>
        We get things wrong. If a review misrepresents a product, or if a specification is out of date because a manufacturer has changed a
        blank or a pole material, please <a href="/contact/">send us a message</a>. We correct
        openly, dated, and named at the bottom of the affected page.
      </p>

      <h2>What we do not do</h2>
      <ul>
        <li>We do not accept manufacturer sponsorship.</li>
        <li>We do not accept free product for review.</li>
        <li>We do not run "sponsored posts" of any kind.</li>
        <li>We do not track visitors beyond basic anonymised traffic analytics. See <a href="/privacy/">privacy policy</a>.</li>
      </ul>

      <div class="callout">
        <strong>The short version.</strong> Independent UK carp gear reviews. Paid for by Amazon commissions on links you click. Scores
        come from specs, listings and owner reviews, not from our own tests. That is it.
      </div>
    </article>
  </div>
</BaseLayout>
