---
import siteConfig from "../data/site.config.json";
import categories from "../data/categories.json";
import "../styles/global.css";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  indexable?: boolean;
  crumbs?: Crumb[];
  jsonLd?: object | object[] | null;
}

const { title, description, indexable = true, crumbs = [], jsonLd = null } = Astro.props;

const jsonLdBlocks: object[] = Array.isArray(jsonLd)
  ? jsonLd.filter((x): x is object => x !== null && x !== undefined)
  : jsonLd
    ? [jsonLd]
    : [];
---
<!doctype html>
<html lang={siteConfig.locale.replace("_", "-").slice(0, 5)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {indexable
      ? <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
      : <meta name="robots" content="noindex,follow" />}
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    {(siteConfig as any).matomoSiteId && (
      <script is:inline define:vars={{ u: (siteConfig as any).matomoUrl, id: (siteConfig as any).matomoSiteId }}>
        var _paq = (window._paq = window._paq || []);
        _paq.push(["trackPageView"]);
        _paq.push(["enableLinkTracking"]);
        _paq.push(["setTrackerUrl", u + "matomo.php"]);
        _paq.push(["setSiteId", id]);
        var g = document.createElement("script");
        g.async = true;
        g.src = u + "matomo.js";
        document.head.appendChild(g);
      </script>
    )}
  </head>
  <body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark">
      <div class="container-lg">
        <a class="navbar-brand" href="/">
          <i class="bi bi-water me-2" style="color: var(--accent);"></i>{siteConfig.siteName}
        </a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#primaryNav"
          aria-controls="primaryNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="primaryNav">
          <ul class="navbar-nav ms-auto align-items-lg-center">
            <li class="nav-item dropdown">
              <a
                class="nav-link dropdown-toggle"
                href="#"
                role="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
              >Kit categories</a>
              <ul class="dropdown-menu dropdown-menu-end">
                {categories.map((c: any) => (
                  <li>
                    <a class="dropdown-item" href={`/gear/${c.slug}/`}>{c.name}</a>
                  </li>
                ))}
              </ul>
            </li>
            <li class="nav-item dropdown">
              <a
                class="nav-link dropdown-toggle"
                href="#"
                role="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
              >Guides</a>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/guides/how-to-choose-first-bivvy/">How to choose your first bivvy</a></li>
                <li><a class="dropdown-item" href="/guides/uk-carp-session-costs/">UK carp season costs</a></li>
                <li><a class="dropdown-item" href="/guides/boilies-explained/">Boilies explained</a></li>
                <li><a class="dropdown-item" href="/guides/carp-rig-fundamentals/">Carp rig fundamentals</a></li>
                <li><a class="dropdown-item" href="/guides/uk-carp-welfare-and-legal-basics/">UK welfare & legal basics</a></li>
              </ul>
            </li>
            <li class="nav-item"><a class="nav-link" href="/compare/">Compare</a></li>
            <li class="nav-item dropdown">
              <a
                class="nav-link dropdown-toggle"
                href="#"
                role="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
              >Data & tools</a>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/tools/session-cost-calculator/">Session cost calculator</a></li>
                <li><a class="dropdown-item" href="/tools/bait-quantity-calculator/">Bait quantity calculator</a></li>
                <li><a class="dropdown-item" href="/data/uk-carp-records/">UK carp records</a></li>
                <li><a class="dropdown-item" href="/data/uk-carp-fishing-stats/">UK carp fishing stats</a></li>
                <li><a class="dropdown-item" href="/data/famous-uk-carp-waters/">Famous UK carp waters</a></li>
                <li><a class="dropdown-item" href="/data/when-to-buy-carp-gear/">When to buy carp gear</a></li>
              </ul>
            </li>
            <li class="nav-item"><a class="nav-link" href="/about/">About</a></li>
          </ul>
        </div>
      </div>
    </nav>

    {crumbs.length > 0 && (
      <div class="container-lg mt-3">
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            {crumbs.map((c) => (
              c.href
                ? <li class="breadcrumb-item"><a href={c.href}>{c.label}</a></li>
                : <li class="breadcrumb-item active" aria-current="page">{c.label}</li>
            ))}
          </ol>
        </nav>
      </div>
    )}

    <main class="flex-grow-1 pb-5">
      <slot />
    </main>

    <footer class="site-footer mt-auto">
      <div class="container-lg">
        <p class="small mb-2">{siteConfig.disclosureText}</p>
        <div class="d-flex flex-wrap gap-3 small">
          <a href="/">Home</a>
          {categories.slice(0, 4).map((c: any) => (
            <a href={`/gear/${c.slug}/`}>{c.short}</a>
          ))}
          <a href="/guides/how-to-choose-first-bivvy/">Buying guide</a>
          <a href="/about/">About</a>
        </div>
        <div class="d-flex flex-wrap gap-3 small mt-2">
          <a href="/legal-notice/">Legal notice</a>
          <a href="/privacy/">Privacy</a>
          <a href="/affiliate-disclosure/">Affiliate disclosure</a>
          <a href="/contact/">Contact</a>
        </div>
        <p class="small mt-3 mb-0" style="opacity: 0.6;">© {new Date().getFullYear()} {siteConfig.siteName}. Amazon and the Amazon logo are trademarks of Amazon.com, Inc. or its affiliates.</p>
      </div>
    </footer>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
